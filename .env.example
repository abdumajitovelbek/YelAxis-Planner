# Public web configuration only. Copy to apps/web/.env.local when a feature needs it.
# Never add service-role keys, session tokens, signing material, or other private credentials.

# Optional account sync; both absent creates a local-only build. Only public values belong here.
VITE_YELAXIS_SUPABASE_URL=
VITE_YELAXIS_SUPABASE_ANON_KEY=
# local permits local-only builds and loopback test backends; hosted accounts require HTTPS.
VITE_YELAXIS_RELEASE_TARGET=local
# Optional public Git revision for explicit support metadata.
VITE_YELAXIS_RELEASE_REVISION=
